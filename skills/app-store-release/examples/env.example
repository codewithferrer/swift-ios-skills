# Copy this file to <config dir>/.env (default: ~/.config/app-store-release/.env)
# and fill in your own values. Never commit the real file.
#
# Generate the API key in App Store Connect:
#   Users and Access -> Integrations -> App Store Connect API -> "+"
#   Role: at least "App Manager" (needs write access to app metadata).
#   Apple lets you download the .p8 file ONCE -- save it right away.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional. Defaults to keys/AuthKey_<ASC_KEY_ID>.p8 inside the config dir.
# Relative paths are resolved against the config dir; absolute paths and ~ work too.
# ASC_PRIVATE_KEY_PATH=keys/AuthKey_XXXXXXXXXX.p8
